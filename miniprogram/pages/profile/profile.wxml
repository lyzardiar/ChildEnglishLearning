<view class="container">
  <text class="page-title">小朋友档案</text>

  <!-- 孩子列表 -->
  <view class="child-list">
    <view class="child-item card" wx:for="{{children}}" wx:key="_id">
      <view class="child-avatar-emoji">{{item.avatar || '🧒'}}</view>
      <view class="child-info">
        <text class="child-name">{{item.name}}</text>
        <text class="child-progress">
          {{item.grade || 1}}年级 · {{item.semester === 'lower' ? '下册' : '上册'}} · Unit {{(item.currentUnit || 0) + 1}}
        </text>
      </view>
      <view class="child-actions">
        <picker mode="selector" range="{{gradeOptions}}" range-key="name" value="{{(item.grade || 1) - 1}}" data-id="{{item._id}}" bindchange="onChildGradeChange">
          <view class="grade-edit">年级</view>
        </picker>
        <view class="delete-btn" data-id="{{item._id}}" catchtap="onDeleteChild">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn" bindtap="onShowAddModal">
    <text class="add-btn-icon">+</text>
    <text class="add-btn-text">添加小朋友</text>
  </view>

  <!-- 添加孩子弹窗 -->
  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="onHideAddModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">添加小朋友</text>

      <view class="avatar-picker">
      <view
        class="avatar-option {{selectedAvatar === index ? 'selected' : ''}}"
        wx:for="{{avatarOptions}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onSelectAvatar"
      >
        <text class="avatar-emoji">{{item}}</text>
      </view>
    </view>

      <text class="form-label">当前年级</text>
      <view class="grade-picker-grid">
        <view
          class="grade-picker-item {{selectedGrade === item.value ? 'selected' : ''}}"
          wx:for="{{gradeOptions}}"
          wx:key="value"
          data-grade="{{item.value}}"
          bindtap="onSelectGrade"
        >
          {{item.value}}
        </view>
      </view>

      <input
        class="name-input"
        placeholder="输入小朋友的名字"
        bindinput="onNameInput"
        bindblur="onNameInput"
        bindconfirm="onNameInput"
        maxlength="8"
        focus="{{showAddModal}}"
      />

      <view class="btn-large btn-primary" bindtap="onConfirmAdd">确认添加</view>
    </view>
  </view>

  <view class="tab-bar-placeholder"></view>
</view>
