/* 个人中心样式 */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 32rpx;
}

/* 孩子列表 */
.child-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.child-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.child-info {
  flex: 1;
}

.child-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.child-progress {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.delete-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
  border-radius: var(--radius-btn);
}

/* 添加按钮 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  border: 3rpx dashed #CCC;
  border-radius: var(--radius-card);
  margin-top: 24rpx;
}

.add-btn-icon {
  font-size: 40rpx;
  color: var(--color-primary);
}

.add-btn-text {
  font-size: 28rpx;
  color: var(--color-primary);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  background: #FFF;
  border-radius: var(--radius-card);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 36rpx;
}

/* 头像选择 */
.avatar-picker {
  display: flex;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.avatar-option {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.avatar-option.selected {
  border-color: var(--color-primary);
  transform: scale(1.1);
}

.avatar-option image {
  width: 100%;
  height: 100%;
}

/* 名字输入 */
.name-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}

/* 图片风格切换 */
.style-section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.style-list {
  display: flex;
  gap: 16rpx;
}

.style-item {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  border: 3rpx solid #E8E8E8;
  text-align: center;
  transition: all 0.3s;
}

.style-item.active {
  border-color: var(--color-primary);
  background: #F0F7FF;
}

.style-name {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
}

.style-item.active .style-name {
  color: var(--color-primary);
}

.style-desc {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}
