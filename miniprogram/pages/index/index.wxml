<view class="container">
  <!-- 顶部：孩子选择 -->
  <view class="child-bar" wx:if="{{children.length > 0}}">
    <view
      class="child-avatar {{currentChild._id === item._id ? 'active' : ''}}"
      wx:for="{{children}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onSwitchChild"
    >
      <text class="avatar-emoji">{{item.avatar || '🧒'}}</text>
      <text class="child-name">{{item.name}}</text>
    </view>
    <navigator url="/pages/profile/profile" open-type="switchTab" class="add-child-btn">
      <text class="add-icon">+</text>
    </navigator>
  </view>

  <!-- 无孩子时的引导 -->
  <view class="empty-guide" wx:if="{{children.length === 0}}">
    <text class="guide-emoji">👋</text>
    <text class="guide-text">先添加一个小朋友吧</text>
    <navigator url="/pages/profile/profile" open-type="switchTab" class="btn-large btn-primary">添加小朋友</navigator>
  </view>

  <!-- 主内容区 -->
  <block wx:if="{{currentChild}}">
    <!-- 学期切换 -->
    <view class="semester-tabs">
      <view
        class="tab {{semester === 'upper' ? 'active' : ''}}"
        data-semester="upper"
        bindtap="onSwitchSemester"
      >上册</view>
      <view
        class="tab {{semester === 'lower' ? 'active' : ''}}"
        data-semester="lower"
        bindtap="onSwitchSemester"
      >下册</view>
    </view>

    <!-- 打卡状态 -->
    <view class="checkin-status card">
      <view class="streak-info">
        <text class="streak-num">{{streakDays}}</text>
        <text class="streak-label">连续打卡天数</text>
      </view>
      <view class="checkin-badge {{todayChecked ? 'done' : ''}}">
        <text>{{todayChecked ? '今日已打卡 ✅' : '今日未打卡'}}</text>
      </view>
    </view>

    <!-- 单元列表 -->
    <view class="unit-list">
      <view
        class="unit-card card"
        wx:for="{{units}}"
        wx:key="id"
      >
        <view class="unit-header" data-index="{{index}}" bindtap="onEnterUnit">
          <view class="unit-icon">
            <text class="unit-num">{{index + 1}}</text>
          </view>
          <view class="unit-info">
            <text class="unit-title">{{item.title}}</text>
            <text class="unit-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
        <view class="unit-actions">
          <view class="action-btn" data-index="{{index}}" bindtap="onEnterUnit">
            <text class="action-emoji">📖</text>
            <text>学单词</text>
          </view>
          <view class="action-btn" data-index="{{index}}" bindtap="onEnterListen">
            <text class="action-emoji">🎧</text>
            <text>听课文</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="tab-bar-placeholder"></view>
</view>
