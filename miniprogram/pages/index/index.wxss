/* 首页样式 */
.child-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}

.child-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  opacity: 0.6;
  transition: all 0.3s;
}

.child-avatar.active {
  opacity: 1;
  transform: scale(1.1);
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.child-avatar.active .avatar-img {
  border-color: var(--color-primary);
}

.child-name {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
}

.child-avatar.active .child-name {
  color: var(--color-primary);
  font-weight: 600;
}

.add-child-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx dashed #CCC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #CCC;
}

/* 空状态引导 */
.empty-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.guide-img {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
}

.guide-text {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  margin-bottom: 48rpx;
}

/* 学期切换 */
.semester-tabs {
  display: flex;
  background: #E8F0FE;
  border-radius: var(--radius-btn);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.semester-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: all 0.3s;
}

.semester-tabs .tab.active {
  background: var(--color-primary);
  color: #FFF;
  font-weight: 600;
}

/* 打卡状态 */
.checkin-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.streak-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.streak-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.streak-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.checkin-badge {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-btn);
  font-size: 24rpx;
  background: #FFF3E0;
  color: var(--color-warning);
}

.checkin-badge.done {
  background: #E8F5E9;
  color: var(--color-success);
}

/* 单元列表 */
.unit-card {
  padding: 24rpx;
}

.unit-header {
  display: flex;
  align-items: center;
}

.unit-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.unit-num {
  color: #FFF;
  font-size: 32rpx;
  font-weight: 700;
}

.unit-info {
  flex: 1;
}

.unit-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.unit-subtitle {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.unit-progress {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.unit-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #F5F7FA;
  border-radius: var(--radius-btn);
  font-size: 24rpx;
  color: var(--color-text);
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}
