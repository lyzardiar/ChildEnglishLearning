<view class="container">
  <!-- 游戏选择界面 -->
  <block wx:if="{{!currentGame}}">
    <!-- 单元选择 -->
    <view class="unit-selector card">
      <scroll-view class="grade-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="grade-options">
          <view
            class="grade-option {{grade === item.grade ? 'active' : ''}}"
            wx:for="{{grades}}"
            wx:key="grade"
            data-grade="{{item.grade}}"
            bindtap="onSwitchGrade"
          >{{item.grade}}年级</view>
        </view>
      </scroll-view>
      <view class="semester-tabs">
        <view
          class="tab {{semester === 'upper' ? 'active' : ''}}"
          data-semester="upper"
          bindtap="onSwitchSemester"
        >上册</view>
        <view
          class="tab {{semester === 'lower' ? 'active' : ''}}"
          data-semester="lower"
          bindtap="onSwitchSemester"
        >下册</view>
      </view>
      <scroll-view class="unit-scroll" scroll-x>
        <view class="unit-chips">
          <view
            class="unit-chip {{unitIndex === index ? 'active' : ''}}"
            wx:for="{{units}}"
            wx:key="id"
            data-index="{{index}}"
            bindtap="onSelectUnit"
          >{{index + 1}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 游戏列表 -->
    <view class="game-list">
      <view
        class="game-card card"
        wx:for="{{games}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectGame"
      >
        <view class="game-icon-wrap" style="background: {{item.color}}20">
          <text class="game-emoji">{{item.icon}}</text>
        </view>
        <view class="game-info">
          <text class="game-name">{{item.name}}</text>
          <text class="game-desc">{{item.desc}}</text>
        </view>
        <view class="game-arrow">›</view>
      </view>
    </view>
  </block>

  <block wx:if="{{currentGame === 'meaning-match'}}">
    <view class="game-header">
      <text class="game-score">得分 {{gameScore}}</text>
      <text class="game-round">{{gameRound}} / {{totalRounds}}</text>
      <view class="exit-btn" bindtap="onExitGame">✕</view>
    </view>

    <view class="listen-match-area">
      <view class="meaning-prompt">
        <text class="meaning-label">选择对应的英文</text>
        <text class="meaning-chinese">{{promptChinese}}</text>
      </view>

      <view class="answer-feedback" wx:if="{{lastAnswerCorrect !== null}}">
        <text class="feedback-text {{lastAnswerCorrect ? 'correct' : 'wrong'}}">{{lastAnswerCorrect ? '答对了' : '再想想'}}</text>
      </view>

      <view class="options-grid">
        <view
          class="option-item {{lastAnswerCorrect !== null && item.english === listenMatchCorrect ? 'highlight' : ''}}"
          wx:for="{{listenMatchOptions}}"
          wx:key="english"
          data-english="{{item.english}}"
          bindtap="onMeaningMatchAnswer"
        >
          <text class="option-text">{{item.english}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 听音选词游戏 -->
  <block wx:if="{{currentGame === 'listen-match'}}">
    <view class="game-header">
      <text class="game-score">⭐ {{gameScore}}</text>
      <text class="game-round">{{gameRound}} / {{totalRounds}}</text>
      <view class="exit-btn" bindtap="onExitGame">✕</view>
    </view>

    <view class="listen-match-area">
      <view class="listen-prompt" bindtap="onReplayWord">
        <text class="listen-hint">🔊 听一听，点一点</text>
        <text class="replay-hint">点击重播</text>
      </view>

      <!-- 答题反馈 -->
      <view class="answer-feedback" wx:if="{{lastAnswerCorrect !== null}}">
        <text class="feedback-text {{lastAnswerCorrect ? 'correct' : 'wrong'}}">
          {{lastAnswerCorrect ? '✓ 真棒！' : '✗ 再听听'}}
        </text>
      </view>

      <view class="options-grid">
        <view
          class="option-item {{lastAnswerCorrect !== null && item.english === listenMatchCorrect ? 'highlight' : ''}}"
          wx:for="{{listenMatchOptions}}"
          wx:key="english"
          data-english="{{item.english}}"
          bindtap="onListenMatchAnswer"
        >
          <text class="option-text">{{item.english}}</text>
          <text class="option-chinese">{{item.chinese}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="tab-bar-placeholder"></view>
</view>
