/* 游戏页样式 */

/* 单元选择器 */
.unit-selector {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.semester-tabs {
  display: flex;
  background: #E8F0FE;
  border-radius: 16rpx;
  padding: 6rpx;
}

.semester-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: all 0.3s;
}

.semester-tabs .tab.active {
  background: var(--color-primary);
  color: #FFF;
  font-weight: 600;
}

.unit-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.unit-chips {
  display: inline-flex;
  gap: 16rpx;
}

.unit-chip {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  transition: all 0.3s;
}

.unit-chip.active {
  background: var(--color-primary);
  color: #FFF;
}

.game-list {
  padding-top: 16rpx;
}

.game-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.game-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.game-emoji {
  font-size: 48rpx;
}

.game-icon {
  width: 56rpx;
  height: 56rpx;
}

.game-info {
  flex: 1;
}

.game-name {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.game-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.game-arrow {
  font-size: 40rpx;
  color: #CCC;
}

/* 游戏内界面 */
.game-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}

.game-score {
  font-size: 32rpx;
  font-weight: 600;
}

.game-round {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.exit-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 听音选图 */
.listen-match-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.listen-prompt {
  margin-bottom: 48rpx;
}

.listen-hint {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  width: 100%;
}

.option-item {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.option-item:active {
  transform: scale(0.95);
}

.option-item.highlight {
  border: 4rpx solid var(--color-success);
  background: #E8F5E9;
}

.option-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.option-chinese {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 答题反馈 */
.answer-feedback {
  margin-bottom: 24rpx;
}

.feedback-text {
  font-size: 32rpx;
  font-weight: 600;
}

.feedback-text.correct {
  color: var(--color-success);
}

.feedback-text.wrong {
  color: var(--color-danger);
}

.replay-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  text-align: center;
}
