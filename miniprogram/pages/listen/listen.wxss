/* 听力页样式 */
.player-controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.control-row {
  display: flex;
  align-items: center;
  gap: 48rpx;
}

.ctrl-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-btn.main {
  width: 112rpx;
  height: 112rpx;
  background: var(--color-primary);
}

.ctrl-btn.main.playing {
  background: var(--color-danger);
}

.ctrl-icon {
  font-size: 36rpx;
}

.ctrl-btn.main .ctrl-icon {
  font-size: 44rpx;
  color: #FFF;
}

.play-all-btn {
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  background: #E8F0FE;
  border-radius: var(--radius-btn);
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 句子列表 */
.sentence-list {
  margin-top: 24rpx;
}

.sentence-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-left: 6rpx solid transparent;
  transition: all 0.3s;
}

.sentence-item.active {
  border-left-color: var(--color-primary);
  background: #F0F7FF;
}

.sentence-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sentence-item.active .sentence-index {
  background: var(--color-primary);
  color: #FFF;
}

.sentence-content {
  flex: 1;
}

.sentence-en {
  font-size: 30rpx;
  display: block;
  line-height: 1.5;
}

.sentence-cn {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: block;
}

.mini-play {
  font-size: 32rpx;
}

/* 切换中文 */
.toggle-chinese {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  margin-top: 16rpx;
}
