<view class="container">
  <!-- 顶部 Tab 切换 -->
  <view class="page-tabs">
    <view class="page-tab {{activeTab === 'words' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="words">
      <text>📖 单词</text>
    </view>
    <view class="page-tab {{activeTab === 'letters' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="letters">
      <text>🔤 字母</text>
    </view>
  </view>

  <!-- === 单词学习 === -->
  <block wx:if="{{activeTab === 'words'}}">
    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{totalCount > 0 ? (currentWordIndex / totalCount * 100) : 0}}%"></view>
    </view>
    <text class="progress-text">{{currentWordIndex + 1}} / {{totalCount}}</text>

    <!-- 单词卡片 -->
    <view class="word-card card" wx:if="{{currentWord}}">
      <image
        wx:if="{{currentWordImage && !imageLoadError}}"
        class="word-image"
        src="{{currentWordImage}}"
        mode="aspectFit"
        binderror="onImageError"
      />
      <view wx:else class="word-image-placeholder">
        <text class="placeholder-emoji">🖼️</text>
      </view>
      <text class="word-english">{{currentWord.english}}</text>
      <text class="word-chinese">{{currentWord.chinese}}</text>

      <!-- 播放示范发音按钮 -->
      <view class="play-btn {{isPlaying ? 'playing' : ''}}" bindtap="onPlayWord">
        <text class="play-emoji" wx:if="{{!isPlaying}}">🔊</text>
        <view class="loading-spinner" wx:else></view>
      </view>
    </view>

    <!-- 操作按钮区 -->
    <view class="action-area">
      <view class="nav-btn {{currentWordIndex === 0 ? 'disabled' : ''}}" bindtap="onPrevWord">
        <text class="nav-arrow">‹</text>
      </view>
      <view class="nav-btn" bindtap="onNextWord">
        <text class="nav-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- === 字母认读 === -->
  <block wx:if="{{activeTab === 'letters'}}">
    <view class="letters-grid">
      <view
        class="letter-card card"
        wx:for="{{letters}}"
        wx:key="letter"
        bindtap="onPlayLetter"
        data-index="{{index}}"
      >
        <text class="letter-big">{{item.letter}}</text>
        <text class="letter-word">{{item.word}}</text>
        <text class="letter-chinese">{{item.chinese}}</text>
        <text class="letter-play">🔊</text>
      </view>
    </view>
  </block>
</view>
