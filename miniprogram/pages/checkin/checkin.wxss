/* 打卡页样式 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.stat-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: #F0F0F0;
}

/* 本周 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: block;
}

.week-row {
  display: flex;
  justify-content: space-between;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.week-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.week-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.week-dot.checked {
  background: var(--color-success);
  color: #FFF;
}

.week-dot.today {
  border: 3rpx solid var(--color-primary);
}

/* 月历 */
.month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.month-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-radius: 50%;
}

.month-day.checked {
  background: #E8F5E9;
  color: var(--color-success);
  font-weight: 600;
}

.month-day.today {
  border: 2rpx solid var(--color-primary);
}

/* 打卡按钮 */
.checkin-btn-area {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.checkin-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  box-shadow: 0 12rpx 32rpx rgba(74, 144, 217, 0.4);
  gap: 8rpx;
  transition: all 0.3s;
}

.checkin-btn.done {
  background: linear-gradient(135deg, var(--color-success), #7ED957);
  box-shadow: 0 12rpx 32rpx rgba(82, 196, 26, 0.3);
}

.checkin-btn-icon {
  font-size: 48rpx;
}

.checkin-btn-text {
  font-size: 24rpx;
  color: #FFF;
  font-weight: 600;
}
