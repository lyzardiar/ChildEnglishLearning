.tab-bar {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-top: 1rpx solid #D9E6EF;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  color: #7B867E;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1;
  color: #7B867E;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
  color: #1677C8;
  font-weight: 700;
}
