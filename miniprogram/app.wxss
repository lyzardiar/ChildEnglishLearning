/* 全局样式 */
page {
  --color-primary: #4A90D9;
  --color-primary-light: #7BB3E8;
  --color-success: #52C41A;
  --color-warning: #FAAD14;
  --color-danger: #FF4D4F;
  --color-bg: #F5F7FA;
  --color-card: #FFFFFF;
  --color-text: #333333;
  --color-text-secondary: #999999;
  --radius-card: 24rpx;
  --radius-btn: 48rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 大按钮（适合儿童点击） */
.btn-large {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.btn-success {
  background: var(--color-success);
  color: #FFFFFF;
}

/* 图标按钮（圆形大按钮，适合儿童） */
.icon-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
}

/* 隐藏原生 tabBar 时的底部占位 */
.tab-bar-placeholder {
  height: 120rpx;
}
