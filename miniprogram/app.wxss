page {
  --color-primary: #1677C8;
  --color-primary-light: #52AFE6;
  --color-primary-soft: #E2F3FD;
  --color-accent: #E85D4A;
  --color-accent-soft: #FCE7E2;
  --color-sun: #F2C84B;
  --color-success: #2F8A61;
  --color-warning: #B86A14;
  --color-danger: #C83E3E;
  --color-bg: #F3F8FC;
  --color-card: #FFFFFF;
  --color-text: #172633;
  --color-text-secondary: #617687;
  --color-line: #D9E6EF;
  --radius-card: 16rpx;
  --radius-control: 12rpx;
  --radius-btn: 12rpx;

  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
  letter-spacing: 0;
}

.container {
  min-height: 100vh;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(23, 57, 82, 0.06);
}

.btn-large {
  width: 100%;
  min-height: 88rpx;
  border-radius: var(--radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-primary {
  color: #FFFFFF;
  background: var(--color-primary);
}

.btn-success {
  color: #FFFFFF;
  background: var(--color-success);
}

.section-heading {
  display: block;
  margin: 32rpx 0 18rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 750;
}

.tab-bar-placeholder {
  height: calc(112rpx + env(safe-area-inset-bottom));
}
