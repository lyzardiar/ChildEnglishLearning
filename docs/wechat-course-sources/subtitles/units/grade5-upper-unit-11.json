        "chinese": "小水滴旅行记"
      },
      {
        "startMs": 202000,
        "endMs": 207000,
        "english": "1. Little Water Drop lives in the sea.",
        "chinese": "1. 小水滴住在海里。"
      },
      {
        "startMs": 207000,
        "endMs": 209000,
        "english": "It is raining.",
        "chinese": "雨下着。"
      },
      {
        "startMs": 209000,
        "endMs": 215000,
        "english": "I want to be up in the sky, says Little Water Drop.",
        "chinese": "我想在天空上飞，小水滴说。"
      },
      {
        "startMs": 215000,
        "endMs": 220000,
        "english": "2. The sun shines and Little Water Drop gets hot.",
        "chinese": "太阳照耀着，小水滴变热了。"
      },
      {
        "startMs": 220000,
        "endMs": 222000,
        "english": "He goes up to the sky.",
        "chinese": "他上天了。"
      },
      {
        "startMs": 222000,
        "endMs": 224000,
        "english": "It is cool there.",
        "chinese": "那里凉快。"
      },
      {
        "startMs": 224000,
        "endMs": 226000,
        "english": "Now he is in a cloud.",
        "chinese": "他现在在云朵里。"
      },
      {
        "startMs": 226000,
        "endMs": 232000,
        "english": "Hooray! I am up in the sky, he says happily.",
        "chinese": "哈啰！我在天空中，他说开心地。"
      },
      {
        "startMs": 232000,
        "endMs": 237000,
        "english": "3. Little Water Drop flies over rivers and mountains.",
        "chinese": "小水滴飞过河流和山脉。"
      },
      {
        "startMs": 237000,
        "endMs": 241000,
        "english": "One day he sees some trees.",
        "chinese": "有一天，他看到一些树。"
      },
      {
        "startMs": 241000,
        "endMs": 243000,
        "english": "We are thirsty.",
        "chinese": "我们口渴了。"
      },
      {
        "startMs": 243000,
        "endMs": 248000,
        "english": "We need water, say the trees.",
        "chinese": "我们需要水。"
      },
      {
        "startMs": 248000,
        "endMs": 253000,
        "english": "4. Little Water Drop falls down to the ground.",
        "chinese": "小水滴落到了地上。"
      },
      {
        "startMs": 253000,
        "endMs": 255000,
        "english": "A tree drinks him.",
        "chinese": "一棵树喝他。"
      },
