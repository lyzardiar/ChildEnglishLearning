      },
      {
        "startMs": 85000,
        "endMs": 87000,
        "english": "What did you see at the museum?",
        "chinese": "你在博物馆里看到了什么？"
      },
      {
        "startMs": 88000,
        "endMs": 91000,
        "english": "I saw a lot of interesting cars.",
        "chinese": "我看到了很多有趣的汽车。"
      },
      {
        "startMs": 93000,
        "endMs": 95000,
        "english": "Listen and say.",
        "chinese": "听并说"
      },
      {
        "startMs": 96000,
        "endMs": 98000,
        "english": "Hi Alice, what's that?",
        "chinese": "嗨，艾丽丝，那是什么？"
      },
      {
        "startMs": 99000,
        "endMs": 100000,
        "english": "It's a toy bee.",
        "chinese": "一只玩具蜜蜂。"
      },
      {
        "startMs": 101000,
        "endMs": 104000,
        "english": "I bought it at an insect museum last Saturday.",
        "chinese": "我上周六在昆虫博物馆买了一件东西。"
      },
      {
        "startMs": 105000,
        "endMs": 106000,
        "english": "It's cute.",
        "chinese": "可爱又肥嘟嘟的。"
      },
      {
        "startMs": 107000,
        "endMs": 108000,
        "english": "What did you see at the museum?",
        "chinese": "你在博物馆里看到了什么？"
      },
      {
        "startMs": 109000,
        "endMs": 114000,
        "english": "I saw ants, bees, butterflies and other insects.",
        "chinese": "我看见蚂蚁、蜜蜂、蝴蝶和其他昆虫。"
      },
      {
        "startMs": 115000,
        "endMs": 119000,
        "english": "Some of them were beautiful but some were very ugly.",
        "chinese": "一些人很美但有些人非常丑陋。"
      },
      {
        "startMs": 120000,
        "endMs": 121000,
        "english": "I learnt a lot about them.",
        "chinese": "我学了很多关于他们的东西。"
      },
      {
        "startMs": 122000,
        "endMs": 123000,
        "english": "That's interesting.",
        "chinese": "那很有意思。我上周去了一家汽车博物馆。"
      },
      {
        "startMs": 124000,
        "endMs": 126000,
        "english": "I went to a car museum last Sunday.",
        "chinese": "我上周日去了汽车博物馆。"
      },
      {
        "startMs": 127000,
        "endMs": 128000,
        "english": "What did you see there?",
        "chinese": "你在那里看到什么了？"
      },
      {
        "startMs": 129000,
        "endMs": 131000,
        "english": "I saw a lot of interesting cars.",
        "chinese": "我看到了很多有趣的汽车。"
      },
      {
        "startMs": 132000,
        "endMs": 134000,
        "english": "Did you buy anything at the car museum?",
        "chinese": "你昨天在汽车博物馆里买了什么东西？"
      },
      {
        "startMs": 135000,
        "endMs": 136000,
        "english": "I bought a model car.",
        "chinese": "我买了一辆模型汽车。"
      },
      {
        "startMs": 137000,
        "endMs": 138000,
        "english": "That's so cool.",
        "chinese": "那真是太酷了。"
      },
      {
        "startMs": 139000,
        "endMs": 140000,
        "english": "I want to go there on Saturday.",
        "chinese": "我想在周六去那里。"
      },
      {
        "startMs": 141000,
        "endMs": 142000,
        "english": "I love museums.",
        "chinese": "我爱博物馆。"
      },
      {
        "startMs": 145000,
        "endMs": 147000,
