      },
      {
        "startMs": 187000,
        "endMs": 189000,
        "english": "We get fruit from trees.",
        "chinese": "我们从树上摘水果。"
      },
      {
        "startMs": 191000,
        "endMs": 193000,
        "english": "We also get wood from trees.",
        "chinese": "我们也从树上得到木头。"
      },
      {
        "startMs": 194000,
        "endMs": 198000,
        "english": "We use wood to make pencils, desks and chairs.",
        "chinese": "我们用木头做铅笔、桌子和椅子。"
      },
      {
        "startMs": 199000,
        "endMs": 202000,
        "english": "We use wood to make paper too.",
