      },
      {
        "startMs": 203000,
        "endMs": 205000,
        "english": "Trees can keep the air clean.",
        "chinese": "树可以保持空气清洁。"
      },
      {
        "startMs": 205000,
        "endMs": 207000,
        "english": "They can cool the air too.",
        "chinese": "它们也能降温。"
      },
      {
        "startMs": 208000,
        "endMs": 210000,
        "english": "Really? That's wonderful.",
        "chinese": "真的吗？那太好了。"
      },
      {
        "startMs": 211000,
        "endMs": 213000,
        "english": "We should plant more trees.",
        "chinese": "我们应该多植树。"
      },
      {
        "startMs": 220000,
        "endMs": 222000,
        "english": "Read a story.",
        "chinese": "读故事。"
      },
      {
        "startMs": 224000,
        "endMs": 226000,
        "english": "The Bird and the Tree",
        "chinese": "鸟和树"
      },
      {
        "startMs": 231000,
        "endMs": 233000,
        "english": "The bird and the tree are friends.",
        "chinese": "鸟和树是朋友。"
      },
      {
        "startMs": 234000,
        "endMs": 237000,
        "english": "The bird often sings songs in the tree.",
        "chinese": "鸟经常在树上唱歌。"
      },
      {
        "startMs": 242000,
        "endMs": 244000,
        "english": "Autumn comes.",
        "chinese": "秋天来了。"
      },
      {
        "startMs": 245000,
        "endMs": 247000,
        "english": "The bird has to fly to the south.",
        "chinese": "鸟要飞向南方。"
      },
      {
        "startMs": 248000,
        "endMs": 250000,
        "english": "See you next spring, Mr. Tree.",
        "chinese": "春天见，树先生。"
      },
      {
        "startMs": 251000,
        "endMs": 253000,
        "english": "See you, Miss Bird. I'll miss you.",
        "chinese": "再见，小鸟小姐。我将想念你。"
      },
      {
        "startMs": 255000,
        "endMs": 257000,
        "english": "Spring comes.",
        "chinese": "春天来了。"
      },
      {
        "startMs": 258000,
        "endMs": 262000,
        "english": "The bird comes back, but she cannot see the tree.",
        "chinese": "鸟回来了，但她看不见树。"
      },
      {
        "startMs": 263000,
        "endMs": 265000,
        "english": "Where's Mr. Tree?",
        "chinese": "树先生在哪里？"
      },
      {
        "startMs": 266000,
        "endMs": 269000,
        "english": "Some workers cut him down and took him to a factory.",
        "chinese": "有些工人把他砍倒了，把他带到工厂。"
      },
      {
        "startMs": 271000,
        "endMs": 273000,
        "english": "The bird flies to the factory.",
        "chinese": "鸟飞到工厂。"
      },
      {
        "startMs": 274000,
        "endMs": 278000,
        "english": "I'm looking for my friend, Mr. Tree. Where is he?",
        "chinese": "我在找我的朋友树先生。他在哪儿？"
      },
      {
        "startMs": 280000,
        "endMs": 282000,
        "english": "The workers cut him into wood.",
        "chinese": "工人把木头切下来。"
      },
      {
        "startMs": 283000,
        "endMs": 285000,
        "english": "They used the wood to make matches.",
        "chinese": "他们用木头做火柴。"
      },
      {
        "startMs": 286000,
        "endMs": 288000,
        "english": "Then they took the matches to a village.",
        "chinese": "然后他们拿火柴去村庄。"
      },
      {
        "startMs": 291000,
        "endMs": 295000,
        "english": "The bird flies to the village and sees a girl beside a fire.",
        "chinese": "鸟飞到村庄，看到火旁的女孩。"
      },
      {
        "startMs": 296000,
        "endMs": 299000,
        "english": "Hello. Are there any matches in your home?",
        "chinese": "你好。你家有没有救生员？"
      },
      {
        "startMs": 300000,
        "endMs": 303000,
        "english": "There were many matches, but now there aren't any.",
        "chinese": "以前有很多比赛，现在没有了。"
      },
      {
        "startMs": 304000,
        "endMs": 306000,
        "english": "I used the last one to make the fire.",
