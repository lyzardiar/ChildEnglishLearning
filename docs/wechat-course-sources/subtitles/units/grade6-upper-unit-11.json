      },
      {
        "startMs": 176000,
        "endMs": 180000,
        "english": "I like trees. They make our city beautiful.",
        "chinese": "我喜欢树。它们让我们的城市美丽。"
      },
      {
        "startMs": 181000,
        "endMs": 183000,
        "english": "Yes, they're important.",
        "chinese": "是的，它们很重要。"
      },
      {
        "startMs": 184000,
        "endMs": 186000,
        "english": "We get a lot of things from trees.",
