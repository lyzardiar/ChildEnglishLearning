      {
        "startMs": 196000,
        "endMs": 200000,
        "english": "1. Hi, I am Yas.",
        "chinese": "1. 嘿，我是雅莎。"
      },
      {
        "startMs": 200000,
        "endMs": 203000,
        "english": "I live in the Stone Age.",
        "chinese": "我生活在石器时代。"
      },
      {
        "startMs": 203000,
        "endMs": 205000,
        "english": "This is my family.",
        "chinese": "这是我的家人。"
      },
      {
        "startMs": 205000,
        "endMs": 207000,
        "english": "We have a fire.",
        "chinese": "我们生火。"
      },
      {
        "startMs": 207000,
        "endMs": 211000,
        "english": "Fire gives us heat and light.",
        "chinese": "火给我们带来热和光。"
      },
      {
        "startMs": 213000,
        "endMs": 217000,
        "english": "2. We always eat meat.",
        "chinese": "我们总是吃肉。"
      },
      {
        "startMs": 217000,
        "endMs": 222000,
        "english": "My parents and my sister like meat, but I hate it.",
        "chinese": "我和姐姐喜欢肉，但我讨厌它。"
      },
      {
        "startMs": 222000,
        "endMs": 226000,
        "english": "It does not taste good at all.",
        "chinese": "一点也不好吃。"
      },
      {
        "startMs": 228000,
        "endMs": 236000,
        "english": "3. I do not want to eat any meat, so I throw it into the fire.",
        "chinese": "三。我不喜欢吃肉，所以我把它扔进火里。"
      },
      {
        "startMs": 238000,
        "endMs": 242000,
        "english": "4. Now the meat smells very nice.",
        "chinese": "现在肉的味道很好。"
      },
      {
        "startMs": 242000,
        "endMs": 247000,
        "english": "5. We eat the meat. It tastes great.",
        "chinese": "我们吃肉。味道很好。"
      },
      {
        "startMs": 247000,
        "endMs": 252000,
        "english": "After that, we cook all our meat on the fire.",
        "chinese": "然后，我们把肉放在火上烤。"
      },
